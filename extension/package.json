{
  "name": "local-selector-translator-extension",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Chrome MV3 extension that translates selected page regions via a local LLM gateway.",
  "scripts": {
    "build": "vite build && vite build --config vite.content.config.ts",
    "dev": "vite build --watch & vite build --watch --config vite.content.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "jsdom": "^24.1.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
